          "location": "loc_grandma_house",
          "area": "area_bedroom",
          "characters": ["char_wolf"],
          "time_of_day": "afternoon",
          "mood": "诡异不安"
        },
        {
          "id": "scene_006",
          "title": "经典问答",
          "summary": "小红帽到达外婆家，对'外婆'的大眼睛、大耳朵、大嘴巴产生疑问，大灰狼露出真面目。",
          "location": "loc_grandma_house",
          "area": "area_bedroom",
          "characters": ["char_red", "char_wolf"],
          "time_of_day": "afternoon",
          "mood": "悬疑紧张，从疑惑升级到恐惧"
